# Rust / Cargo
/target
**/*.rs.bk

# WASM build output (generated by wasm-pack)
frontend/src/wasm/

# Node / npm
node_modules/
frontend/dist/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Env
.env
.env.local

# Vite cache
frontend/.vite/

# OpenCode internal artifacts (skill registry cache, not project content)
.atl/

# SDDK local working artifacts (ADR-0022 local-only policy)
sddk/
openspec/
cycles/

# Playwright outputs
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Test coverage
coverage/
**/*.lcov
*.coverage

# Build caches
.eslintcache
.cache/
.parcel-cache/

# Temp
/tmp/

# Playwright CLI debug snapshots
.playwright-cli/

# Cargo lockfile is committed (per Rust workspace convention)
# !Cargo.lock
# Rust test artifacts
**/test-results/
**/.vite/
